{
  "schema_purpose": "planning schema only; no paid data acquired",
  "root_after_authorized_acquisition": "docs/ratings-evidence-2026-10-29/acquisition/bbi-<capture-date>/",
  "folders": {
    "raw/": "unaltered exposed downloads or permitted table copies; immutable originals",
    "metadata/": "batch manifest, filters, field dictionary, identities, sample/units and access notes",
    "normalized/": "long-form CSV or JSONL retaining source references; research-only candidates",
    "coverage/": "coverage/missingness/duplicate/join reports",
    "scouting/": "timestamped explicit claims, labeled implications/counterevidence/calibration ranges",
    "validation/": "document-level QA and comparisons; no season tests in research lane"
  },
  "batch_record_required": [
    "batch_id",
    "source_url",
    "provider",
    "captured_at_utc",
    "provider_as_of_or_unknown",
    "season_raw",
    "season_normalized",
    "season_type",
    "selected_metrics",
    "representation",
    "filters",
    "min_minutes_filter",
    "rows_displayed",
    "rows_captured",
    "pagination",
    "capture_method",
    "raw_file",
    "raw_sha256",
    "notes"
  ],
  "value_record": {
    "batch_id": "string",
    "provider_player_id": "string|null",
    "canonical_player_id": "string|null",
    "player_name_raw": "string",
    "team_raw": "string",
    "record_scope": "season_total|team_stint|unknown",
    "season": "YYYY-YY",
    "season_type": "regular|playoffs|play_in|projection|unknown",
    "metric_key_raw": "string",
    "metric_key_normalized": "string",
    "value_raw": "string|null",
    "value_numeric": "number|null",
    "units": "string|unknown",
    "representation": "value|grade|percentile|rank|value_plus|unknown",
    "evidence_kind": "count|rate|stabilized_estimate|provider_model|context|projection|unknown",
    "sample_count": "number|null",
    "sample_unit": "string|null",
    "sample_status": "observed|modeled|unavailable|not_applicable",
    "missing_reason": "string|null",
    "definition_version": "string|unknown",
    "source_cell_or_row": "string",
    "normalization_note": "string|null"
  },
  "identity_policy": [
    "Keep original names, IDs and total/stint distinctions.",
    "Review ambiguous matches rather than merging by stripped accents alone.",
    "Do not sum total rows with their component stints.",
    "Canonical team-prefixed ID is identity, not proof of past team membership."
  ],
  "scouting_record": {
    "claim_id": "stable string",
    "player_id": "string|null",
    "source": "retained transcript/video URL",
    "published_on": "date|unknown",
    "timestamp_start": "HH:MM:SS",
    "timestamp_end": "HH:MM:SS",
    "speaker": "unidentified or locally supported identity",
    "explicit_claim_paraphrase": "string",
    "implication": "string|null",
    "implication_reasoning": "string|null",
    "classification": "demonstrated_ability|role_context|health|forecast|ambiguous",
    "counterevidence_and_disagreement": "string",
    "corroboration_lineage": "independent|same_source|unknown",
    "proposed_range": "object|null",
    "range_is_calibration_judgment": true,
    "confidence": "string",
    "cutoff_treatment": "pre_start|post_start|unknown",
    "status": "supported|provisional|hold|superseded"
  },
  "write_policy": "research folder only; normalized data are not production imports or rating overrides"
}